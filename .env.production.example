# Production Environment Variables Example for Glassbox AI

# ── Backend Configuration ──
GROQ_API_KEY=gsk_your_groq_api_key_here
CLERK_SECRET_KEY=sk_live_or_test_clerk_secret_key
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# Set DEV_AUTH_BYPASS to false in production to enforce Clerk JWT authentication
DEV_AUTH_BYPASS=false

# PostgreSQL Connection String (e.g. Neon, Supabase, AWS RDS)
DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require

# Redis Connection String (e.g. Upstash, AWS ElastiCache)
REDIS_URL=rediss://default:password@host:port

# Allowed CORS Origins (comma-separated list of domain origins)
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ── Frontend Configuration ──
NEXT_PUBLIC_API_URL=https://api.your-domain.com
NEXT_PUBLIC_WS_URL=wss://api.your-domain.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_or_test_clerk_publishable_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
