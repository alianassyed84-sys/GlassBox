GROQ_API_KEY=your_groq_api_key_here
# Model used: openai/gpt-oss-120b (via Groq)
# PostgreSQL Database (Required for Phase 2 pgvector semantic search)
DATABASE_URL=postgresql://user:password@localhost:5432/glassbox

# Redis (Required for Phase 3 background tasks and WebSocket Pub/Sub)
# Sign up at https://upstash.com/ for a free Redis instance
REDIS_URL=rediss://default:password@your-endpoint:port

# OpenTelemetry Exporter (Optional - Phase 3)
# Sign up at https://www.honeycomb.io/ for a free tier
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io/v1/traces
OTEL_EXPORTER_OTLP_HEADERS="x-honeycomb-team=your_api_key_here"
